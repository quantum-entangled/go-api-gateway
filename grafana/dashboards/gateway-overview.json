{
  "annotations": {
    "list": []
  },
  "editable": true,
  "fiscalYearStartMonth": 0,
  "graphTooltip": 1,
  "panels": [
    {
      "title": "Request Rate (req/s)",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "reqps",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "rate(gateway_requests_total{http_path!=\"/healthz\"}[1m])",
          "legendFormat": "{{http_method}} {{http_path}} {{http_status}}"
        }
      ]
    },
    {
      "title": "Request Duration p50 / p95 / p99",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 0
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "s",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "histogram_quantile(0.50, sum by (http_path, le) (rate(gateway_request_duration_seconds_bucket{http_path!=\"/healthz\"}[1m])))",
          "legendFormat": "p50 {{http_path}}"
        },
        {
          "expr": "histogram_quantile(0.95, sum by (http_path, le) (rate(gateway_request_duration_seconds_bucket{http_path!=\"/healthz\"}[1m])))",
          "legendFormat": "p95 {{http_path}}"
        },
        {
          "expr": "histogram_quantile(0.99, sum by (http_path, le) (rate(gateway_request_duration_seconds_bucket{http_path!=\"/healthz\"}[1m])))",
          "legendFormat": "p99 {{http_path}}"
        }
      ]
    },
    {
      "title": "Total Requests",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 0,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "blue"
              }
            ]
          }
        },
        "overrides": []
      },
      "options": {
        "colorMode": "value"
      },
      "targets": [
        {
          "expr": "sum(gateway_requests_total{http_path!=\"/healthz\"})",
          "legendFormat": "total"
        }
      ]
    },
    {
      "title": "Error Rate (5xx)",
      "type": "stat",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 6,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "percentunit",
          "thresholds": {
            "mode": "absolute",
            "steps": [
              {
                "value": null,
                "color": "green"
              },
              {
                "value": 0.01,
                "color": "yellow"
              },
              {
                "value": 0.05,
                "color": "red"
              }
            ]
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum(rate(gateway_requests_total{http_status=~\"5..\",http_path!=\"/healthz\"}[1m])) / (sum(rate(gateway_requests_total{http_path!=\"/healthz\"}[1m])) > 0)",
          "legendFormat": "error rate"
        }
      ]
    },
    {
      "title": "Requests by Status",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 12,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (http_status) (gateway_requests_total{http_path!=\"/healthz\"})",
          "legendFormat": "{{http_status}}"
        }
      ]
    },
    {
      "title": "Requests by Path",
      "type": "piechart",
      "gridPos": {
        "h": 8,
        "w": 6,
        "x": 18,
        "y": 8
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "targets": [
        {
          "expr": "sum by (http_path) (gateway_requests_total{http_path!=\"/healthz\"})",
          "legendFormat": "{{http_path}}"
        }
      ]
    },
    {
      "title": "Goroutines",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 0,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "go_goroutine_count{job=\"go-api-gateway\"}",
          "legendFormat": "goroutines"
        }
      ]
    },
    {
      "title": "Memory Used",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 12,
        "x": 12,
        "y": 16
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "bytes",
          "custom": {
            "drawStyle": "line",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "go_memory_used_bytes{job=\"go-api-gateway\"}",
          "legendFormat": "{{go_memory_type}}"
        }
      ]
    },
    {
      "title": "Upstream Health History",
      "type": "timeseries",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 24
      },
      "datasource": {
        "type": "prometheus",
        "uid": "prometheus"
      },
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "min": 0,
          "custom": {
            "drawStyle": "line",
            "lineInterpolation": "stepAfter",
            "fillOpacity": 10
          }
        },
        "overrides": []
      },
      "targets": [
        {
          "expr": "sum by (service) (gateway_upstream_healthy)",
          "legendFormat": "{{service}} healthy"
        },
        {
          "expr": "count by (service) (gateway_upstream_healthy)",
          "legendFormat": "{{service}} total"
        }
      ]
    },
    {
      "title": "Recent Logs",
      "type": "logs",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 32
      },
      "datasource": {
        "type": "loki",
        "uid": "loki"
      },
      "options": {
        "showTime": true,
        "showLabels": false,
        "wrapLogMessage": true,
        "enableLogDetails": true,
        "sortOrder": "Descending",
        "displayedFields": [
          "___LOG_LINE_BODY___",
          "method",
          "path",
          "status",
          "duration_ms",
          "request_id"
        ]
      },
      "targets": [
        {
          "expr": "{service_name=\"go-api-gateway\"} | path != `/healthz`"
        }
      ]
    },
    {
      "title": "Recent Traces",
      "type": "table",
      "gridPos": {
        "h": 8,
        "w": 24,
        "x": 0,
        "y": 40
      },
      "datasource": {
        "type": "tempo",
        "uid": "tempo"
      },
      "targets": [
        {
          "queryType": "traceql",
          "query": "{resource.service.name=\"go-api-gateway\" && span.http.path!=\"/healthz\"}",
          "limit": 20
        }
      ]
    }
  ],
  "refresh": "10s",
  "schemaVersion": 39,
  "time": {
    "from": "now-15m",
    "to": "now"
  },
  "title": "Gateway Overview",
  "uid": "gateway-overview"
}